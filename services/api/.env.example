# Claude (read by the Anthropic SDK). Without it the service runs in rules-only mode.
ANTHROPIC_API_KEY=

# Shared secret with the Next.js server. Empty disables the check (local dev only).
MIZAN_INTERNAL_API_KEY=

# Supabase Postgres. Empty = offline mode using app/data/fixture_passages.json.
# Use the pooler connection string (transaction mode) for the running service,
# and the direct/session connection string for scripts/load_corpus.py.
MIZAN_DATABASE_URL=
MIZAN_CORPUS_VERSION=2026-10-04

# Optional overrides
# MIZAN_LLM_MODEL=claude-sonnet-5-5
# MIZAN_LLM_EFFORT_EXTRACT=low
# MIZAN_LLM_EFFORT_ADJUDICATE=medium
# MIZAN_LLM_FALLBACKS=true
# MIZAN_T_EXACT=92
# MIZAN_T_VARIANT=75
