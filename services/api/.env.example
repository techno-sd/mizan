# Claude (read by the Anthropic SDK). Without it the service runs in rules-only mode.
ANTHROPIC_API_KEY=

# Shared secret with the Next.js server. Empty disables the check (local dev only).
MIZAN_INTERNAL_API_KEY=

# Postgres (production: Neon, Frankfurt). Empty = offline mode using app/data/fixture_passages.json.
# Use the pooled connection string (host contains "-pooler") for the running service; the loaders
# (scripts/load_corpus.py, scripts/load_translations.py) switch to the direct host themselves.
# Note: the async driver cannot run on Windows' default event loop; run the service on Linux/macOS or WSL,
# or leave this empty for local work on Windows.
MIZAN_DATABASE_URL=
MIZAN_CORPUS_VERSION=2026-10-05.2

# Optional overrides
# MIZAN_LLM_MODEL=claude-sonnet-5-5
# MIZAN_LLM_EFFORT_EXTRACT=low
# MIZAN_LLM_EFFORT_ADJUDICATE=medium
# MIZAN_LLM_FALLBACKS=true
# MIZAN_LLM_CACHE_ENABLED=false  # disables reads/writes of extracted quotations in the LLM cache
# MIZAN_T_EXACT=92
# MIZAN_T_VARIANT=75
